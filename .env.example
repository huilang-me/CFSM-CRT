# 复制为 .env（或 .env.local）后填写。
# .env 已被 .gitignore 忽略，不会提交到仓库；真实环境变量优先级高于本文件。

# Worker 地址，多个用英文逗号分隔
API_BASE=https://your-worker.example.workers.dev

# 页面标题
TITLE=

# 背景图 URL
BACKGROUND_IMAGE=

# 追加到 CSP connect-src 的域名（API_BASE 会自动加入，一般留空）
CSP_API=

# 追加到 CSP script/style/img/font 指令的域名
CSP_STATIC=

# 本地开发 / 预览时 vite 的代理目标
VITE_DEV_PROXY_TARGET=https://localhost:8787
